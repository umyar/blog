---
// Sits in the footer, so it renders on every page — including the prerendered
// ones. It only talks to /api/subscribe from the browser, which keeps the host
// page static.
---

<!-- #subscribe is the scroll target for the hero CTA on the homepage. -->
<div
  id="subscribe"
  class="scroll-mt-24 rounded-2xl border border-zinc-100 p-6 dark:border-zinc-700/40"
  data-subscribe-root
>
  <h2 class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">Get new posts by email</h2>
  <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
    One email per post. Nothing else, and you can leave in one click.
  </p>

  <form class="mt-4 flex flex-col gap-3 sm:flex-row" data-subscribe-form>
    <label class="sr-only" for="subscribe-email">Email address</label>
    <input
      id="subscribe-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      maxlength="254"
      placeholder="you@example.com"
      class="min-w-0 flex-auto rounded-lg border border-zinc-200 px-3 py-2 text-sm text-zinc-800 outline-none focus:border-grad-from dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
    />
    <!-- Honeypot (COMMENTS_V2.md §5.4). Hidden from sight, from the tab order and
         from screen readers, so the only thing that can fill it is a bot that
         completes every input it finds. Not type="hidden": plenty of bots skip
         those. tabindex="-1" and aria-hidden are what keep it off a real
         reader's path — never hide a honeypot with `display:none` alone if you
         also want autofill to leave it be. -->
    <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
      <label>
        Website
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          data-subscribe-honeypot
        />
      </label>
    </div>
    <button
      type="submit"
      class="shrink-0 rounded-full bg-gradient-to-r from-grad-from to-grad-to px-4 py-2 text-sm font-semibold text-white transition hover:opacity-90 disabled:opacity-50"
    >
      Subscribe
    </button>
  </form>

  <p class="mt-3 hidden text-sm" data-subscribe-message role="status" aria-live="polite"></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-subscribe-root]');
  const form = root?.querySelector<HTMLFormElement>('[data-subscribe-form]');
  const message = root?.querySelector<HTMLParagraphElement>('[data-subscribe-message]');

  if (form && message) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const honeypot = form.querySelector<HTMLInputElement>('[data-subscribe-honeypot]')!;
    // Measured from when the form became interactive, not from page load, so a
    // reader who lands mid-article and scrolls to the footer half an hour later
    // is timed from the moment they could first have typed.
    const shownAt = Date.now();

    const show = (text: string, ok: boolean) => {
      message.textContent = text;
      message.classList.remove('hidden');
      message.classList.toggle('text-zinc-500', ok);
      message.classList.toggle('dark:text-zinc-400', ok);
      message.classList.toggle('text-red-600', !ok);
    };

    // Arriving from the homepage CTA (or a shared #subscribe link) puts the
    // cursor in the field — the click already said what they came to do.
    // preventScroll keeps focus from cancelling the smooth scroll mid-animation.
    const focusIfTargeted = () => {
      if (window.location.hash === '#subscribe' && !form.classList.contains('hidden')) {
        input.focus({ preventScroll: true });
      }
    };
    window.addEventListener('hashchange', focusIfTargeted);
    focusIfTargeted();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;

      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: input.value.trim(),
          website: honeypot.value,
          elapsedMs: Date.now() - shownAt,
        }),
      }).catch(() => null);

      if (res?.ok) {
        // Deliberately the same wording whether or not the address was already
        // on the list — the endpoint doesn't distinguish, and neither should this.
        form.classList.add('hidden');
        show('Check your inbox — there’s a confirmation link waiting. It expires in 24 hours.', true);
        return;
      }

      if (res?.status === 429) {
        show('Too many signups from here just now. Try again a bit later.', false);
      } else if (res?.status === 400) {
        show('That doesn’t look like a valid email address.', false);
      } else {
        show('Something went wrong — please try again in a moment.', false);
      }

      button.disabled = false;
    });
  }
</script>
