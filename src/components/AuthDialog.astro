---
// One sign-in surface for the whole site (COMMENTS_V2.md §3.3). Rendered once per
// page from BaseLayout; the header, the comment composer and (later) the like
// button all drive it through `window.openAuthDialog()` rather than shipping
// their own form — which is what the two near-duplicate forms in AuthWidget and
// CommentsSection used to be.
//
// Native <dialog> on purpose: `showModal()` gives us the focus trap, the inert
// background, Esc-to-close and the top-layer stacking for free, none of which is
// worth reimplementing.
import AvatarField from './AvatarField.astro';
---

<dialog id="auth-dialog" class="auth-dialog" aria-labelledby="auth-dialog-title">
  <div class="relative p-7">
    <button
      type="button"
      id="auth-dialog-close"
      aria-label="Close"
      class="absolute top-4 right-4 rounded-full p-1.5 text-zinc-400 transition hover:bg-zinc-100 hover:text-zinc-700 dark:hover:bg-zinc-700/50 dark:hover:text-zinc-200"
    >
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4">
        <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"></path>
      </svg>
    </button>

    <h2 id="auth-dialog-title" class="gradient-text text-xl font-bold tracking-tight">Sign in</h2>
    <p id="auth-dialog-reason" class="mt-1 hidden text-sm text-zinc-500 dark:text-zinc-400"></p>

    <!-- Step 1 — address -->
    <div id="auth-step-email" class="hidden">
      <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
        We'll email you a 6-digit code. No password, and you stay on this page.
      </p>
      <form id="auth-email-form" class="mt-5 flex flex-col gap-3">
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="auth-input"
        />
        <!-- Honeypot (COMMENTS_V2.md §5.4) — same trick as SubscribeForm: out of
             sight, out of the tab order and out of the accessibility tree, so
             only a bot filling every input reaches it. Its value travels as a
             header, not a body field, because the plugin's zod schema strips
             keys it doesn't declare. -->
        <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" id="auth-honeypot" />
          </label>
        </div>
        <p id="auth-email-error" class="hidden text-sm text-red-600"></p>
        <button type="submit" class="auth-submit">Email me a code</button>
      </form>
    </div>

    <!-- Step 2 — code -->
    <div id="auth-step-code" class="hidden">
      <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
        Sent to <strong id="auth-code-address" class="text-zinc-700 dark:text-zinc-300"></strong>. It
        expires in 10 minutes.
      </p>
      <form id="auth-code-form" class="mt-5 flex flex-col gap-3">
        <input
          type="text"
          name="code"
          required
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9]*"
          maxlength="6"
          placeholder="······"
          aria-label="6-digit code"
          class="auth-input auth-code-input"
        />
        <p id="auth-code-error" class="hidden text-sm text-red-600"></p>
        <button type="submit" class="auth-submit">Sign in</button>
      </form>
      <div class="mt-3 flex items-center justify-between text-xs">
        <button
          type="button"
          id="auth-code-back"
          class="text-zinc-400 transition hover:text-zinc-700 dark:hover:text-zinc-200"
        >
          ← Use a different address
        </button>
        <button type="button" id="auth-code-resend" class="gradient-text font-semibold">
          Resend code
        </button>
      </div>
    </div>

    <!-- Step 3 — profile, only when it isn't finished yet -->
    <div id="auth-step-profile" class="hidden">
      <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
        Last thing — this is what shows next to your comments. Only asked once.
      </p>
      <form id="auth-profile-form" class="mt-5 flex flex-col gap-3">
        <div class="flex gap-3">
          <input
            type="text"
            name="firstName"
            required
            maxlength="60"
            autocomplete="given-name"
            placeholder="First name"
            class="auth-input min-w-0 flex-1"
          />
          <input
            type="text"
            name="lastName"
            required
            maxlength="60"
            autocomplete="family-name"
            placeholder="Last name"
            class="auth-input min-w-0 flex-1"
          />
        </div>

        <!-- Optional, and behind a disclosure so the two required fields are the
             whole visible ask (COMMENTS_V2.md §4.3.5). -->
        <details class="group">
          <summary
            class="cursor-pointer list-none text-xs text-zinc-400 transition hover:text-zinc-600 dark:hover:text-zinc-300"
          >
            <span class="group-open:hidden">Add a photo (optional) →</span>
            <span class="hidden group-open:inline">Photo — optional, initials are used otherwise</span>
          </summary>
          <div class="mt-3">
            <AvatarField compact />
          </div>
        </details>

        <p id="auth-profile-error" class="hidden text-sm text-red-600"></p>
        <button type="submit" class="auth-submit">Save and continue</button>
      </form>
    </div>

    <!--
      COMMENTS_V2.md §9.1 puts this on the code step. It lives *outside* the
      steps instead, and shows on both 'code' and 'profile', because §9.5 wants an
      already-subscribed reader to see that state rather than a no-op checkbox —
      and that can only be known once there is a session. On the code step there
      isn't one yet, and looking the typed address up to find out would answer
      "does this address read this blog?" to anyone who can type it, reintroducing
      exactly the enumeration hole §5.5 closed. So: unchecked and inert before
      sign-in, real state after it. Kept out of both <form>s so neither submit
      handler sees it — it is read directly, never through FormData.
    -->
    <div id="auth-subscribe-row" class="mt-4 hidden">
      <label class="flex items-start gap-2 text-sm text-zinc-600 dark:text-zinc-400">
        <input
          type="checkbox"
          id="auth-subscribe"
          class="mt-0.5 h-4 w-4 flex-none accent-grad-from"
        />
        <span id="auth-subscribe-label">Also email me when there's a new post.</span>
      </label>
    </div>
  </div>
</dialog>

<script>
  import { authClient } from '../lib/auth-client';
  import { initAvatarField } from '../lib/avatar-field';

  const dialog = document.getElementById('auth-dialog') as HTMLDialogElement;
  const closeBtn = document.getElementById('auth-dialog-close')!;
  const reasonEl = document.getElementById('auth-dialog-reason')!;

  const steps = {
    email: document.getElementById('auth-step-email')!,
    code: document.getElementById('auth-step-code')!,
    profile: document.getElementById('auth-step-profile')!,
  };

  const emailForm = document.getElementById('auth-email-form') as HTMLFormElement;
  const emailError = document.getElementById('auth-email-error')!;
  const honeypot = document.getElementById('auth-honeypot') as HTMLInputElement;
  const codeForm = document.getElementById('auth-code-form') as HTMLFormElement;
  const codeError = document.getElementById('auth-code-error')!;
  const codeAddress = document.getElementById('auth-code-address')!;
  const codeBackBtn = document.getElementById('auth-code-back')!;
  const codeResendBtn = document.getElementById('auth-code-resend') as HTMLButtonElement;
  const subscribeRow = document.getElementById('auth-subscribe-row')!;
  const subscribeBox = document.getElementById('auth-subscribe') as HTMLInputElement;
  const subscribeLabel = document.getElementById('auth-subscribe-label')!;
  const profileForm = document.getElementById('auth-profile-form') as HTMLFormElement;
  const profileError = document.getElementById('auth-profile-error')!;
  const avatarField = initAvatarField(profileForm.querySelector<HTMLElement>('[data-avatar-field]')!);

  // Resolved on the dialog's `close` event, so Esc and the backdrop settle the
  // caller's promise exactly like the close button does.
  let resolver: ((ok: boolean) => void) | null = null;
  let succeeded = false;
  let pendingEmail = '';
  // Reset each time the dialog opens, not at page load: the reader may have had
  // the article open for an hour before deciding to comment, and the interval
  // that matters is the one they spent looking at this form.
  let openedAt = Date.now();

  function showStep(name: keyof typeof steps) {
    for (const [key, el] of Object.entries(steps)) el.classList.toggle('hidden', key !== name);
    // Hidden on 'email': there is nothing to attach a subscription to until the
    // reader has committed to an address.
    subscribeRow.classList.toggle('hidden', name === 'email');
    const focusTarget = steps[name].querySelector<HTMLInputElement>('input');
    // Deferred: an <input> inside a just-unhidden container isn't focusable yet.
    requestAnimationFrame(() => focusTarget?.focus());
  }

  function showError(el: HTMLElement, message: string) {
    el.textContent = message;
    el.classList.remove('hidden');
  }

  function busy(form: HTMLFormElement, on: boolean) {
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) btn.disabled = on;
  }

  function finish() {
    succeeded = true;
    dialog.close();
  }

  dialog.addEventListener('close', () => {
    const resolve = resolver;
    resolver = null;
    resolve?.(succeeded);
  });

  closeBtn.addEventListener('click', () => dialog.close());

  // A click that lands on the <dialog> itself rather than on its content box is a
  // backdrop click — showModal() gives no other way to detect one.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  // Better Auth's core `name` and `image` fields are stored in first_name and
  // avatar_url (see lib/auth.ts) — so the first name really is `user.name` here.
  function seedProfile(user: { id: string; email: string; name?: string | null; image?: string | null; lastName?: string | null }) {
    const first = profileForm.elements.namedItem('firstName') as HTMLInputElement;
    const last = profileForm.elements.namedItem('lastName') as HTMLInputElement;
    first.value = user.name ?? '';
    last.value = user.lastName ?? '';
    const urlInput = profileForm.querySelector<HTMLInputElement>('[data-avatar-url]')!;
    urlInput.value = user.image ?? '';
    avatarField.setIdentity({
      id: user.id,
      firstName: user.name ?? '',
      lastName: user.lastName ?? '',
      email: user.email,
    });
  }

  async function open(opts?: AuthDialogOptions): Promise<boolean> {
    const { data } = await authClient.getSession();
    // Already usable — don't make the reader look at a dialog to be told so.
    if (data?.user.profileComplete) return true;
    if (data) seedProfile(data.user);

    succeeded = false;
    pendingEmail = '';
    openedAt = Date.now();
    for (const el of [emailError, codeError, profileError]) el.classList.add('hidden');
    emailForm.reset();
    codeForm.reset();
    codeForm.classList.remove('hidden');

    reasonEl.textContent = opts?.reason ?? '';
    reasonEl.classList.toggle('hidden', !opts?.reason);

    void refreshSubscribeState();

    showStep(data ? 'profile' : 'email');
    dialog.showModal();

    return new Promise<boolean>((resolve) => {
      resolver = resolve;
    });
  }

  window.openAuthDialog = open;

  async function sendCode(email: string, errorEl: HTMLElement): Promise<boolean> {
    const { error } = await authClient.emailOtp.sendVerificationOtp(
      { email, type: 'sign-in' },
      {
        // The two anti-bot signals ride as headers because the endpoint's body
        // schema is the plugin's and drops anything it doesn't declare. Read
        // back by the `before` hook in lib/auth.ts.
        headers: {
          'x-blog-hp': honeypot.value,
          'x-blog-elapsed': String(Date.now() - openedAt),
        },
      }
    );
    if (error) {
      // 429 is the rate limiter (per-IP, from lib/auth.ts) — worth saying plainly,
      // because "try again in a moment" would be wrong by up to an hour.
      if (error.status === 429) {
        showError(errorEl, 'Too many sign-in attempts from here. Try again a little later.');
      } else {
        showError(errorEl, "Couldn't send the code — please try again in a moment.");
      }
      return false;
    }
    return true;
  }

  emailForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    emailError.classList.add('hidden');
    const email = String(new FormData(emailForm).get('email') || '')
      .trim()
      .toLowerCase();
    if (!email) return;

    busy(emailForm, true);
    const ok = await sendCode(email, emailError);
    busy(emailForm, false);
    if (!ok) return;

    pendingEmail = email;
    codeAddress.textContent = email;
    codeError.classList.add('hidden');
    showStep('code');
  });

  codeBackBtn.addEventListener('click', () => {
    codeError.classList.add('hidden');
    showStep('email');
  });

  codeResendBtn.addEventListener('click', async () => {
    if (!pendingEmail) return;
    codeError.classList.add('hidden');
    codeResendBtn.disabled = true;
    codeResendBtn.textContent = 'Sending…';
    const ok = await sendCode(pendingEmail, codeError);
    codeResendBtn.textContent = ok ? 'Code resent' : 'Resend code';
    // Long enough that double-tapping can't mail two codes; the server-side
    // per-address cooldown is the real guard (phase 3).
    setTimeout(() => {
      codeResendBtn.disabled = false;
      codeResendBtn.textContent = 'Resend code';
    }, 30_000);
  });

  /**
   * COMMENTS_V2.md §9.2. Only ever called with the box ticked — an unticked box
   * makes no request at all, which is what guarantees §9.4's "an unticked box
   * must never change subscription state in either direction".
   *
   * Runs after the session exists, so the endpoint takes the address from the
   * session rather than from anything typed here.
   */
  async function applySubscription() {
    if (!subscribeBox.checked || subscribeBox.disabled) return;
    // A failure here must not cost the reader their sign-in — they came to
    // comment, not to subscribe. Worst case the box silently didn't take.
    try {
      await fetch('/api/subscribe/me', { method: 'POST' });
    } catch {
      /* ignore */
    }
  }

  /**
   * §9.5, and the one place this spec collides with itself.
   *
   * The checkbox lives on the code step, which is *before* the reader has proven
   * anything. Looking their address up there to decide whether to show "You're
   * already subscribed" would answer "does this address subscribe to this blog?"
   * to anyone who can type it — reintroducing exactly the enumeration hole §5.5
   * closed on the OTP endpoint. So the lookup is session-gated and therefore only
   * possible once a session already exists.
   */
  async function refreshSubscribeState() {
    subscribeBox.checked = false;
    subscribeBox.disabled = false;
    subscribeLabel.textContent = "Also email me when there's a new post.";

    const { data } = await authClient.getSession();
    if (!data) return;

    const res = await fetch('/api/subscribe/me');
    if (!res.ok) return;
    const { subscribed } = (await res.json()) as { subscribed: boolean };
    if (!subscribed) return;

    subscribeBox.checked = true;
    subscribeBox.disabled = true;
    subscribeLabel.textContent = "You're already subscribed.";
  }

  async function afterSignIn() {
    await applySubscription();

    const { data } = await authClient.getSession();
    if (data && !data.user.profileComplete) {
      profileError.classList.add('hidden');
      seedProfile(data.user);
      showStep('profile');
      return;
    }
    finish();
  }

  codeForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    codeError.classList.add('hidden');
    const otp = String(new FormData(codeForm).get('code') || '').trim();
    if (!otp) return;

    busy(codeForm, true);
    const { error } = await authClient.signIn.emailOtp({ email: pendingEmail, otp });
    busy(codeForm, false);

    if (error) {
      const code = error.code ?? '';
      if (code === 'TOO_MANY_ATTEMPTS') {
        showError(codeError, 'Too many wrong codes. Request a fresh one to try again.');
      } else if (code === 'OTP_EXPIRED') {
        showError(codeError, 'That code expired. Send yourself a new one.');
      } else {
        showError(codeError, "That code didn't match. Check it and try again.");
      }
      codeForm.reset();
      codeForm.querySelector<HTMLInputElement>('input')?.focus();
      return;
    }

    await afterSignIn();
  });

  profileForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    profileError.classList.add('hidden');
    const data = new FormData(profileForm);

    busy(profileForm, true);
    const res = await fetch('/api/profile', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        firstName: String(data.get('firstName') || '').trim(),
        lastName: String(data.get('lastName') || '').trim(),
        // '' is valid — it means "use the monogram".
        avatarUrl: avatarField.getUrl(),
      }),
    });
    busy(profileForm, false);

    if (!res.ok) {
      showError(profileError, 'Please check the fields and try again.');
      return;
    }
    finish();
  });
</script>
