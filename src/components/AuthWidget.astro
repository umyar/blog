---
// Client-driven: post pages are static/prerendered, so session state can't be
// read server-side here — everything below resolves after mount via the
// Better Auth client (see the <script> at the bottom).
---

<div
  id="auth-widget"
  class="mt-10 border-t border-zinc-200 pt-8 text-sm dark:border-zinc-700/50"
>
  <p id="auth-loading" class="text-zinc-400 dark:text-zinc-500">Checking sign-in status…</p>

  <div id="auth-signed-out" class="hidden">
    <form id="magic-link-form" class="flex flex-wrap items-center gap-2">
      <input
        type="email"
        name="email"
        required
        placeholder="you@example.com"
        class="min-w-0 flex-1 rounded-full border border-zinc-200 px-4 py-2 text-sm text-zinc-800 outline-none focus:border-grad-from dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
      />
      <button
        type="submit"
        class="rounded-full bg-gradient-to-r from-grad-from to-grad-to px-4 py-2 text-sm font-semibold text-white transition hover:opacity-90"
      >
        Continue with email
      </button>
    </form>
    <p id="magic-link-sent" class="hidden text-zinc-500 dark:text-zinc-400">
      Check your inbox for a sign-in link.
    </p>
    <p id="magic-link-error" class="hidden text-red-600"></p>
  </div>

  <div id="auth-incomplete" class="hidden">
    <a
      id="auth-incomplete-link"
      href="/welcome"
      class="gradient-text font-semibold hover:opacity-80"
    >
      Finish setting up your profile to comment →
    </a>
  </div>

  <div id="auth-signed-in" class="hidden items-center justify-between gap-4">
    <span class="text-zinc-500 dark:text-zinc-400">
      Signed in as <strong id="auth-name" class="text-zinc-800 dark:text-zinc-200"></strong>
    </span>
    <button
      id="sign-out-btn"
      type="button"
      class="rounded-full border border-zinc-200 px-3 py-1 text-xs text-zinc-500 transition hover:border-zinc-400 hover:text-zinc-800 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-zinc-500 dark:hover:text-zinc-200"
    >
      Sign out
    </button>
  </div>
</div>

<script>
  import { authClient } from '../lib/auth-client';

  const loadingEl = document.getElementById('auth-loading')!;
  const signedOutEl = document.getElementById('auth-signed-out')!;
  const incompleteEl = document.getElementById('auth-incomplete')!;
  const incompleteLink = document.getElementById('auth-incomplete-link') as HTMLAnchorElement;
  const signedInEl = document.getElementById('auth-signed-in')!;
  const nameEl = document.getElementById('auth-name')!;
  const magicLinkForm = document.getElementById('magic-link-form') as HTMLFormElement;
  const sentEl = document.getElementById('magic-link-sent')!;
  const errorEl = document.getElementById('magic-link-error')!;
  const signOutBtn = document.getElementById('sign-out-btn')!;

  function showOnly(el: HTMLElement) {
    for (const e of [signedOutEl, incompleteEl, signedInEl]) e.classList.add('hidden');
    loadingEl.classList.add('hidden');
    el.classList.remove('hidden');
  }

  async function refresh() {
    const { data } = await authClient.getSession();
    if (!data) {
      showOnly(signedOutEl);
    } else if (!data.user.profileComplete) {
      const next = window.location.pathname + window.location.search;
      incompleteLink.href = `/welcome?next=${encodeURIComponent(next)}`;
      showOnly(incompleteEl);
    } else {
      nameEl.textContent = `${data.user.firstName ?? ''} ${data.user.lastName ?? ''}`.trim();
      signedInEl.classList.remove('hidden', 'flex');
      signedInEl.classList.add('flex');
      loadingEl.classList.add('hidden');
      signedOutEl.classList.add('hidden');
      incompleteEl.classList.add('hidden');
    }
  }

  magicLinkForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    const email = String(new FormData(magicLinkForm).get('email') || '');
    const next = window.location.pathname + window.location.search;

    const submitBtn = magicLinkForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;

    const { error } = await authClient.signIn.magicLink({
      email,
      callbackURL: next,
      newUserCallbackURL: `/welcome?next=${encodeURIComponent(next)}`,
    });

    submitBtn.disabled = false;
    if (error) {
      errorEl.textContent = 'Could not send the link — please try again.';
      errorEl.classList.remove('hidden');
      return;
    }
    magicLinkForm.classList.add('hidden');
    sentEl.classList.remove('hidden');
  });

  signOutBtn.addEventListener('click', async () => {
    await authClient.signOut();
    window.location.reload();
  });

  refresh();
</script>
