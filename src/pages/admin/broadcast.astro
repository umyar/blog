---
export const prerender = false;

import { count, eq } from 'drizzle-orm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { auth } from '../../lib/auth';
import { db } from '../../lib/db';
import { broadcast, subscriber } from '../../lib/db/schema';
import { isAdmin } from '../../lib/admin';
import { siteUrl } from '../../lib/site';
import { fetchPostIndex, broadcastLang, LANG_LABELS } from '../../lib/post-index';

const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session || !isAdmin(session.user.id)) {
  return Astro.redirect('/');
}

const [counts] = await db
  .select({ status: subscriber.status, total: count() })
  .from(subscriber)
  .where(eq(subscriber.status, 'confirmed'))
  .groupBy(subscriber.status);

const confirmedCount = counts?.total ?? 0;

const [pending] = await db
  .select({ total: count() })
  .from(subscriber)
  .where(eq(subscriber.status, 'pending'))
  .groupBy(subscriber.status);

const posts = await fetchPostIndex(siteUrl(Astro.request)).catch(() => []);
const sentRows = await db.select().from(broadcast);
const sentBySlug = new Map(sentRows.map((r) => [r.postSlug, r]));

const rows = posts.map((p) => {
  const lang = broadcastLang(p.langs);
  return {
    slug: p.slug,
    date: p.date,
    lang,
    title: p.title[lang] ?? p.slug,
    langs: p.langs.map((l) => LANG_LABELS[l]).join(' · '),
    sent: sentBySlug.get(p.slug) ?? null,
  };
});
---

<BaseLayout title="Broadcast — umyar blog" description="Admin-only new-post announcements.">
  <div class="mx-auto mt-16 w-full max-w-7xl px-6 sm:px-14 lg:px-24">
    <div class="mx-auto max-w-5xl">
      <h1 class="gradient-text text-2xl font-bold tracking-tight">Broadcast</h1>
      <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
        <strong class="text-zinc-700 dark:text-zinc-300">{confirmedCount}</strong> confirmed
        {confirmedCount === 1 ? 'subscriber' : 'subscribers'}
        {pending?.total ? ` · ${pending.total} still unconfirmed` : ''}
      </p>

      {confirmedCount === 0 && (
        <p
          class="mt-6 rounded-xl border border-zinc-200 bg-zinc-50 p-4 text-sm text-zinc-500 dark:border-zinc-700/50 dark:bg-zinc-800/50 dark:text-zinc-400"
        >
          Nobody has confirmed a subscription yet, so there's nothing to send.
        </p>
      )}

      <ul class="mt-8 flex flex-col gap-3">
        {
          rows.map((r) => (
            <li
              data-slug={r.slug}
              class="rounded-xl border border-zinc-200 bg-white p-4 text-sm dark:border-zinc-700/50 dark:bg-zinc-800"
            >
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-medium text-zinc-800 dark:text-zinc-100">{r.title}</p>
                  <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">
                    {r.slug} · {r.date} · {r.langs} · links to {LANG_LABELS[r.lang]}
                  </p>
                  <p
                    class="broadcast-status mt-1 text-xs text-zinc-400 dark:text-zinc-500"
                    data-sent={r.sent ? 'true' : 'false'}
                  >
                    {r.sent
                      ? `Sent to ${r.sent.recipientCount} on ${new Date(r.sent.sentAt).toLocaleString()}${
                          r.sent.failedCount ? ` · ${r.sent.failedCount} failed` : ''
                        }`
                      : 'Not sent yet'}
                  </p>
                </div>

                <button
                  class="broadcast-send shrink-0 rounded-full bg-gradient-to-r from-grad-from to-grad-to px-4 py-2 text-xs font-semibold text-white transition hover:opacity-90 disabled:opacity-40"
                  data-slug={r.slug}
                  data-sent={r.sent ? 'true' : 'false'}
                  data-count={confirmedCount}
                  disabled={confirmedCount === 0}
                >
                  {r.sent ? 'Send again' : 'Send to subscribers'}
                </button>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.broadcast-send').forEach((button) => {
    button.addEventListener('click', async () => {
      const slug = button.dataset.slug!;
      const alreadySent = button.dataset.sent === 'true';
      const count = button.dataset.count;

      const warning = alreadySent
        ? `This post was already announced. Send it to all ${count} subscribers AGAIN?`
        : `Send "${slug}" to ${count} subscribers? This can't be undone.`;
      if (!confirm(warning)) return;

      const status = button
        .closest('li')!
        .querySelector<HTMLParagraphElement>('.broadcast-status')!;

      button.disabled = true;
      const original = button.textContent;
      button.textContent = 'Sending…';

      const res = await fetch('/api/admin/broadcast', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        // `force` mirrors the confirm above — the API refuses a repeat send
        // unless it's explicitly asked for.
        body: JSON.stringify({ slug, force: alreadySent }),
      }).catch(() => null);

      const data = await res?.json().catch(() => null);

      if (!res?.ok) {
        status.textContent = `Failed: ${data?.error ?? 'network error'}`;
        button.disabled = false;
        button.textContent = original;
        return;
      }

      status.textContent = `Sent to ${data.sent}${data.failed ? ` · ${data.failed} failed` : ''} just now`;
      button.dataset.sent = 'true';
      button.textContent = 'Send again';
      button.disabled = false;
    });
  });
</script>
