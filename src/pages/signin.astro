---
import BaseLayout from '../layouts/BaseLayout.astro';
import { auth } from '../lib/auth';

// Session-dependent, so it renders per request.
export const prerender = false;

// Same rule as /welcome: only same-origin, non-protocol-relative paths, so a
// crafted ?next= can't bounce a freshly signed-in reader off-site.
function safeNext(raw: string | null): string {
  if (!raw) return '/';
  try {
    const decoded = decodeURIComponent(raw);
    if (decoded.startsWith('/') && !decoded.startsWith('//')) return decoded;
  } catch {}
  return '/';
}

const session = await auth.api.getSession({ headers: Astro.request.headers });
const next = safeNext(Astro.url.searchParams.get('next'));

if (session?.user.profileComplete) {
  return Astro.redirect(next);
}
---

<BaseLayout title="Sign in — umyar blog" description="Sign in to comment on umyar's blog.">
  <div class="mx-auto mt-16 w-full max-w-7xl px-6 sm:px-14 lg:px-24">
    <div class="mx-auto max-w-md">
      <div
        class="rounded-2xl bg-white p-8 shadow-md ring-1 shadow-zinc-800/5 ring-zinc-900/5 dark:border dark:border-zinc-700/50 dark:bg-zinc-800 dark:ring-0"
      >
        <h1 class="gradient-text text-2xl font-bold tracking-tight">Sign in</h1>
        <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
          An account is only needed to comment — reading never asks for one. We email you a 6-digit
          code; there's no password to remember.
        </p>
        <button type="button" id="signin-open" class="auth-submit mt-6" data-next={next}>
          Continue with email
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // No form of its own on purpose — AuthDialog (mounted by BaseLayout) is the one
  // implementation of this flow, and duplicating it here is exactly what
  // COMMENTS_V2.md §3.3 set out to remove. The page is the entry point; the
  // dialog is still the form.
  const openBtn = document.getElementById('signin-open') as HTMLButtonElement;
  const next = openBtn.dataset.next || '/';

  async function run() {
    const ok = await window.openAuthDialog?.({ reason: 'Signing in takes about twenty seconds.' });
    if (ok) window.location.href = next;
  }

  openBtn.addEventListener('click', run);
  run();
</script>
